# Credenciales del contenedor de Postgres (docker compose lee este archivo)
POSTGRES_USER=goat
POSTGRES_PASSWORD=change_me
POSTGRES_DB=goat
POSTGRES_PORT=5432

# Conexión usada por Prisma. Debe coincidir con los valores de arriba.
DATABASE_URL="postgresql://goat:change_me@localhost:5432/goat?schema=public"

# Clave para sellar la cookie de sesión (ADR 0002). Mínimo 32 caracteres.
# Generar una propia: openssl rand -base64 32
SESSION_SECRET="cambiar_por_una_clave_propia_de_32_caracteres_o_mas"

# Contraseña que usa `npm run db:seed`. En producción debe tener >= 12 caracteres y no ser "goat1234".
SEED_PASSWORD="goat1234"

# Opcional: Almacenamiento de fotos en Railway Bucket (S3-compatible).
# Si no se definen, las fotos se guardan localmente en public/uploads/professionals/.
# AWS_ENDPOINT_URL="https://storage.railway.app"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET_NAME=""
# AWS_DEFAULT_REGION="auto"
