// Modelo de datos vigente (Incrementos 1 a 3).
//
// Nombres de dominio: docs/glossary.md. Historias: docs/hu/.
// Documentación en español, código en inglés (AGENTS.md).
//
// Convenciones de este schema:
// - Las horas del patrón semanal se guardan como minutos desde la medianoche
//   (0 a 1440), no como `time`: simplifica comparaciones y la restricción de
//   solapamiento en la base.
// - Los instantes (`startsAt`, `endsAt`, auditoría) son `timestamptz`.
// - Las bajas son lógicas: campo `active`, nunca se borra el registro.
// - Las restricciones de solapamiento son `EXCLUDE ... USING gist`, escritas a
//   mano en la migración: Prisma no las declara (ver ADR 0001, "Concurrencia
//   en turnos").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

/// Rol del usuario. `PATIENT` está declarado pero no se usa en el Inc. 1.
enum Role {
  RECEPTIONIST
  PROFESSIONAL
  MANAGER
  PATIENT
}

enum DocumentType {
  DNI
  LC
  LE
  CI
  PASSPORT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Cobertura del paciente: particular u obra social.
enum CoverageType {
  PRIVATE
  HEALTH_INSURANCE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// `SCHEDULED` es el único estado desde el que se transiciona; los otros tres
/// son finales. `EXPIRED` lo marca el usuario a mano (no hay proceso automático).
enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  EXPIRED
}

/// Tipo de cambio registrado sobre un turno ya creado. El alta no genera
/// evento: su autoría vive en `Appointment.createdById`.
enum AppointmentEventType {
  UPDATED
  CANCELLED
  COMPLETED
  EXPIRED
  /// Otro horario o profesional, mismo turno (HU-16).
  RESCHEDULED
  /// Cambio de prioridad (HU-19).
  PRIORITY_CHANGED
}

/// Prioridad del turno (HU-19). Un turno `URGENT` lleva su motivo.
enum AppointmentPriority {
  NORMAL
  URGENT
}

/// Estado del cobro (HU-21). Un turno tiene como máximo un cobro `PAID`; sin
/// cobro vigente está pendiente de cobro, que no es un estado persistido.
enum PaymentStatus {
  PAID
  VOIDED
}

enum ProfessionalEventType {
  UPDATED
  DEACTIVATED
  REACTIVATED
}

// ────────────────────────────── Acceso ───────────────────────────────

/// Cuenta con la que se ingresa al sistema (HU-01). El ingreso es por email y
/// contraseña; la sesión es una cookie sellada y no se persiste (ADR 0002),
/// así que acá solo vive la credencial.
model User {
  id Int @id @default(autoincrement())

  /// Identificador de ingreso (ADR 0002): obligatorio y único.
  email              String   @unique
  /// argon2id, con sus parámetros incluidos. Nunca la contraseña en claro.
  passwordHash       String
  /// HU-31: el acceso temporal exige cambiar la contraseña al primer ingreso.
  mustChangePassword Boolean  @default(false)
  lastName           String
  firstName          String
  /// Teléfono de contacto interno.
  phone              String?
  role               Role
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  /// Ficha del profesional, cuando el usuario atiende en el centro.
  professional Professional? @relation("ProfessionalUser")
  patient      Patient?      @relation("PatientUser")

  createdProfessionals     Professional[]          @relation("ProfessionalCreatedBy")
  updatedProfessionals     Professional[]          @relation("ProfessionalUpdatedBy")
  deactivatedProfessionals Professional[]          @relation("ProfessionalDeactivatedBy")
  createdPatients          Patient[]               @relation("PatientCreatedBy")
  updatedPatients          Patient[]               @relation("PatientUpdatedBy")
  createdExceptions        AvailabilityException[] @relation("AvailabilityExceptionCreatedBy")
  createdHolidays          Holiday[]               @relation("HolidayCreatedBy")
  createdAppointments      Appointment[]           @relation("AppointmentCreatedBy")
  authorizedAppointments   Appointment[]           @relation("AppointmentAuthorizedBy")
  appointmentEvents        AppointmentEvent[]
  professionalEvents       ProfessionalEvent[]
  createdPayments          Payment[]               @relation("PaymentCreatedBy")
  voidedPayments           Payment[]               @relation("PaymentVoidedBy")
  cashClosings             CashClosing[]           @relation("CashClosingClosedBy")

  @@index([lastName, firstName])
}

// ───────────────────────── Profesionales ─────────────────────────────

/// Título de profesión (traumatólogo, kinesiólogo). Un profesional puede
/// tener más de uno. No confundir con `Specialty` ni con `Service`.
model ProfessionalTitle {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  professionals Professional[]
}

/// Área o línea de atención del centro (columna, rodilla, infantil…).
model Specialty {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  services Service[]
}

/// Consultorio o box. En el Inc. 1 cada profesional atiende en el suyo.
model Room {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  availabilityWindows AvailabilityWindow[]
}

model Professional {
  id Int @id @default(autoincrement())

  /// Cuenta con la que ingresa, si tiene acceso al sistema (HU-12).
  userId Int?  @unique
  user   User? @relation("ProfessionalUser", fields: [userId], references: [id])

  lastName       String
  firstName      String
  documentType   DocumentType
  documentNumber String
  /// Matrícula: numérica, de 1 a 8 dígitos (el formato lo valida Zod).
  licenseNumber  String       @unique
  phone          String?
  email          String?
  photoUrl       String?
  notes          String?
  active         Boolean      @default(true)

  /// Baja lógica (HU-03): fecha efectiva, motivo y quién la hizo.
  deactivatedAt      DateTime?
  deactivationReason String?
  deactivatedById    Int?
  deactivatedBy      User?     @relation("ProfessionalDeactivatedBy", fields: [deactivatedById], references: [id])

  createdById Int
  createdBy   User  @relation("ProfessionalCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User? @relation("ProfessionalUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titles              ProfessionalTitle[]
  services            Service[]
  availabilityWindows AvailabilityWindow[]
  exceptions          AvailabilityException[]
  appointments        Appointment[]
  events              ProfessionalEvent[]
  encounters          Encounter[]

  /// Reprogramaciones que movieron un turno desde o hacia este profesional.
  rescheduledFromEvents AppointmentEvent[] @relation("AppointmentEventPreviousProfessional")
  rescheduledToEvents   AppointmentEvent[] @relation("AppointmentEventNewProfessional")

  @@unique([documentType, documentNumber])
  @@index([lastName, firstName])
  @@index([active])
}

/// Historial inmutable de cambios posteriores al alta de un profesional.
model ProfessionalEvent {
  id             Int                   @id @default(autoincrement())
  professionalId Int
  professional   Professional          @relation(fields: [professionalId], references: [id])
  type           ProfessionalEventType
  reason         String
  changes        Json?
  userId         Int
  user           User                  @relation(fields: [userId], references: [id])
  createdAt      DateTime              @default(now())

  @@index([professionalId, createdAt])
}

// ─────────────────────── Catálogo de servicios ───────────────────────

/// Prestación: lo que se hace en el turno. Fija la duración del bloque.
model Service {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  description      String?
  /// Duración del bloque que ocupa en la agenda. En el Inc. 1 son 30 para
  /// todos los servicios, pero el valor es propio de cada uno.
  durationMinutes  Int
  /// Requiere orden médica.
  requiresReferral Boolean  @default(false)
  /// Valor de la prestación (HU-20). Se mantiene separado de la cobertura y de
  /// lo que paga el paciente (`Payment.amount`). Sin valor no se cobra (HU-21).
  price            Decimal? @db.Decimal(12, 2)
  active           Boolean  @default(true)

  specialtyId Int?
  specialty   Specialty? @relation(fields: [specialtyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professionals       Professional[]
  availabilityWindows AvailabilityWindow[]
  appointments        Appointment[]

  @@index([active])
}

// ───────────────────────────── Agenda ────────────────────────────────

/// Franja de atención del patrón semanal de un profesional (HU-05).
/// Se repite todas las semanas hasta que se modifique.
model AvailabilityWindow {
  id             Int          @id @default(autoincrement())
  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id])
  weekday        Weekday
  /// Minutos desde la medianoche. `startMinute` < `endMinute`.
  startMinute    Int
  endMinute      Int

  roomId Int?
  room   Room? @relation(fields: [roomId], references: [id])

  /// Servicios habilitados en esta franja. Vacío significa todos los que
  /// presta el profesional.
  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId, weekday])
}

/// Excepción al patrón semanal: día u horario en que el profesional no
/// atiende (ausencia puntual, vacaciones, congreso).
model AvailabilityException {
  id             Int          @id @default(autoincrement())
  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id])
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  /// Minutos desde la medianoche. Ambos nulos = el día entero.
  startMinute    Int?
  endMinute      Int?
  reason         String

  createdById Int
  createdBy   User @relation("AvailabilityExceptionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([professionalId, startDate, endDate])
}

/// Cierre del centro: fechas inclusivas, con tramo opcional repetido cada día
/// (HU-23). Ambos minutos nulos significan días completos.
model Holiday {
  id          Int      @id @default(autoincrement())
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  startMinute Int?
  endMinute   Int?
  description String

  createdById Int
  createdBy   User @relation("HolidayCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([startDate, endDate])
}

// ──────────────────────────── Pacientes ──────────────────────────────

model Patient {
  /// Acceso opcional al portal (HU-31). La DAL exige un User de rol PATIENT.
  userId Int?  @unique
  user   User? @relation("PatientUser", fields: [userId], references: [id], onDelete: Restrict)

  id             Int          @id @default(autoincrement())
  lastName       String
  firstName      String
  gender         Gender
  documentType   DocumentType
  documentNumber String
  birthDate      DateTime     @db.Date
  phone          String
  email          String
  coverageType   CoverageType
  /// Responsable o tutor, para pacientes menores de edad.
  guardianName   String?
  guardianPhone  String?

  /// Ficha completa (HU-17). Todo opcional: el alta no se alarga.
  address                      String?
  city                         String?
  /// Nombre y teléfono van juntos (restricción en la migración).
  emergencyContactName         String?
  emergencyContactPhone        String?
  /// Vínculo con el paciente (madre, pareja, vecino…).
  emergencyContactRelationship String?
  /// Observaciones administrativas del mostrador. No son datos clínicos.
  notes                        String?

  active Boolean @default(true)

  createdById Int
  createdBy   User  @relation("PatientCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User? @relation("PatientUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Presente solo cuando `coverageType` es `HEALTH_INSURANCE`.
  coverage     Coverage?
  appointments Appointment[]

  @@unique([documentType, documentNumber])
  @@index([lastName, firstName])
  @@index([documentNumber])
}

/// Obra social.
model HealthInsurer {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  plans InsurancePlan[]
}

/// Plan dentro de una obra social.
model InsurancePlan {
  id              Int           @id @default(autoincrement())
  healthInsurerId Int
  healthInsurer   HealthInsurer @relation(fields: [healthInsurerId], references: [id])
  name            String
  active          Boolean       @default(true)

  coverages Coverage[]

  @@unique([healthInsurerId, name])
}

/// Afiliación del paciente: plan y número de afiliado. Sin coseguro (Inc. 3).
model Coverage {
  id        Int     @id @default(autoincrement())
  patientId Int     @unique
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  insurancePlanId Int
  insurancePlan   InsurancePlan @relation(fields: [insurancePlanId], references: [id])
  /// Número de afiliado.
  memberNumber    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── Turnos ────────────────────────────────

/// Reserva de la agenda de un profesional para un paciente, con una
/// prestación. `endsAt` lo calcula la DAL con la duración del `Service`.
model Appointment {
  id             Int          @id @default(autoincrement())
  patientId      Int
  patient        Patient      @relation(fields: [patientId], references: [id])
  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id])
  serviceId      Int
  service        Service      @relation(fields: [serviceId], references: [id])

  startsAt DateTime
  endsAt   DateTime
  status   AppointmentStatus @default(SCHEDULED)
  notes    String?

  /// Prioridad (HU-19). Un turno `URGENT` exige motivo (restricción en la
  /// migración).
  priority       AppointmentPriority @default(NORMAL)
  priorityReason String?

  /// Orden o autorización de la obra social (HU-21). Los tres campos se
  /// cargan juntos, al llegar el paciente.
  authorizationNumber String?
  authorizedAt        DateTime?
  authorizedById      Int?
  authorizedBy        User?     @relation("AppointmentAuthorizedBy", fields: [authorizedById], references: [id])

  createdById Int
  createdBy   User @relation("AppointmentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Todo cambio posterior al alta (cancelación, cierre, vencimiento,
  /// reprogramación, prioridad).
  events    AppointmentEvent[]
  /// Cobros del turno: a lo sumo uno `PAID`, más los anulados.
  payments  Payment[]
  encounter Encounter?

  @@index([professionalId, startsAt])
  @@index([patientId, startsAt])
  @@index([startsAt])
  @@index([status])
}

/// Traza de los cambios de un turno: qué cambió, quién, cuándo y por qué.
/// El alta no genera evento (ver `Appointment.createdById`).
model AppointmentEvent {
  id            Int                  @id @default(autoincrement())
  appointmentId Int
  appointment   Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          AppointmentEventType
  /// Motivo. Obligatorio al cancelar (HU-10); lo exige la DAL.
  reason        String?
  /// Quién solicitó el cambio (el paciente, el profesional, el centro).
  requestedBy   String?

  /// Horario y profesional antes y después (HU-16). Obligatorios en
  /// `RESCHEDULED`, nulos en el resto (restricción en la migración).
  previousStartsAt       DateTime?
  previousEndsAt         DateTime?
  previousProfessionalId Int?
  previousProfessional   Professional? @relation("AppointmentEventPreviousProfessional", fields: [previousProfessionalId], references: [id])
  newStartsAt            DateTime?
  newEndsAt              DateTime?
  newProfessionalId      Int?
  newProfessional        Professional? @relation("AppointmentEventNewProfessional", fields: [newProfessionalId], references: [id])

  /// Prioridad antes y después (HU-19). Obligatorias en `PRIORITY_CHANGED`,
  /// nulas en el resto.
  previousPriority AppointmentPriority?
  newPriority      AppointmentPriority?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([appointmentId, createdAt])
}

// ────────────────────────────── Cobros ───────────────────────────────

/// Una atención por turno (HU-25). Autor y plazo de edición se verifican en
/// la DAL. Los textos no se exponen a mesa de entradas, gerente ni paciente.
model Encounter {
  id             Int          @id @default(autoincrement())
  appointmentId  Int          @unique
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  notes          String
  indications    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([professionalId, createdAt])
}

/// Foto del cierre de un día local del centro (HU-27). No se reabre ni se
/// reescriben sus importes al anular un cobro: se muestra un total corregido.
model CashClosing {
  id                 Int       @id @default(autoincrement())
  date               DateTime  @unique @db.Date
  paymentCount       Int
  totalAmount        Decimal   @db.Decimal(12, 2)
  expectedCashAmount Decimal   @db.Decimal(12, 2)
  countedCashAmount  Decimal   @db.Decimal(12, 2)
  difference         Decimal   @db.Decimal(12, 2)
  notes              String?
  closedById         Int
  closedBy           User      @relation("CashClosingClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  closedAt           DateTime  @default(now())
  payments           Payment[]
}

/// Medio de pago que acepta el centro (HU-20). No se borra: se desactiva.
model PaymentMethod {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

/// Cobro de un turno a un paciente particular, con un solo medio de pago
/// (HU-21). No se borra: se anula con motivo y se vuelve a cobrar con una
/// fila nueva. Un turno tiene como máximo un cobro `PAID` (índice único
/// parcial en la migración).
model Payment {
  id            Int          @id @default(autoincrement())
  /// Secuencia única; no se reutiliza al anular y puede tener saltos por rollback.
  receiptNumber Int          @unique @default(autoincrement())
  /// Nulo mientras el día está abierto. Se vincula al cerrar la caja (HU-27).
  cashClosingId Int?
  cashClosing   CashClosing? @relation(fields: [cashClosingId], references: [id], onDelete: Restrict)
  appointmentId Int
  appointment   Appointment  @relation(fields: [appointmentId], references: [id])

  paymentMethodId Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  /// Lo que pagó el paciente: el valor del servicio en el momento del cobro.
  /// No cambia si después cambia `Service.price`.
  amount Decimal       @db.Decimal(12, 2)
  status PaymentStatus @default(PAID)

  /// Quién cobró y cuándo.
  createdById Int
  createdBy   User     @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  /// Anulación: los tres se cargan juntos, solo en `VOIDED`.
  voidedAt   DateTime?
  voidedById Int?
  voidedBy   User?     @relation("PaymentVoidedBy", fields: [voidedById], references: [id])
  voidReason String?

  @@index([appointmentId])
  @@index([createdAt])
  @@index([cashClosingId])
}
